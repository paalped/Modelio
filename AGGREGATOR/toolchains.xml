<?xml version="1.0" encoding="UTF-8"?>
<toolchains xmlns="http://maven.apache.org/TOOLCHAINS/1.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/TOOLCHAINS/1.1.0 http://maven.apache.org/xsd/toolchains-1.1.0.xsd">

    <toolchain>
        <type>jdk</type>
        <provides>
            <version>1.8</version>
            <vendor>temurin</vendor>
            <id>JavaSE-1.8</id>
        </provides>
        <configuration>
            <!-- Java 8 unavailable on Apple Silicon Homebrew; JDK 11 compiles BREE 1.8 bundles -->
            <jdkHome>/opt/homebrew/opt/openjdk@11/libexec/openjdk.jdk/Contents/Home</jdkHome>
        </configuration>
    </toolchain>

    <toolchain>
        <type>jdk</type>
        <provides>
            <version>11</version>
            <vendor>temurin</vendor>
            <id>JavaSE-11</id>
        </provides>
        <configuration>
            <jdkHome>/opt/homebrew/opt/openjdk@11/libexec/openjdk.jdk/Contents/Home</jdkHome>
        </configuration>
    </toolchain>

</toolchains>
